{
  "parser": "@babel/eslint-parser",
  "env": {
    "browser": true,
    "node": true,
    "jest/globals": true
  },
  "extends": "airbnb",
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/jsx-filename-extension": "off",
    "react/style-prop-object": "off",
    "template-curly-spacing" : "off",
    "indent": ["error", 2, {
      "ignoredNodes": ["TemplateLiteral"]
    }]
  },
  "globals": {
    "React": "writable"
  },
  "plugins": ["jest"]
}
