{
  "name": "wax-attic-splash",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:geometry": "node scripts/generate-geometry.mjs",
    "check:geometry": "node scripts/check-geometry.mjs",
    "optimize:media": "node scripts/optimize-media.mjs",
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "commitlint": "commitlint",
    "format": "prettier --write . && stylelint --fix \"src/**/*.css\"",
    "format:check": "prettier --check .",
    "lint": "yarn lint:eslint && yarn lint:styles && yarn format:check",
    "lint:eslint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "postinstall": "husky",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "yarn lint && yarn build && yarn check:geometry",
    "podman:dev": "podman compose -f compose.yml up",
    "firebase:preview": "firebase hosting:channel:deploy preview --only staging --expires 7d",
    "firebase:deploy": "firebase deploy --only hosting:production"
  },
  "dependencies": {
    "astro": "^5.8.1",
    "gsap": "3.15.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "10.0.1",
    "@types/three": "0.185.4",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "firebase-tools": "^14.5.1",
    "globals": "17.11.0",
    "husky": "^9.1.7",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.69.0"
  },
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "yarn@1.22.22"
}
