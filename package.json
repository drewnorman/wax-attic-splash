{
  "name": "wax-attic-splash",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "commitlint": "commitlint",
    "postinstall": "husky",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "test": "yarn build",
    "podman:dev": "podman compose -f compose.yml up",
    "firebase:preview": "firebase hosting:channel:deploy preview --only staging --expires 7d",
    "firebase:deploy": "firebase deploy --only hosting:production"
  },
  "dependencies": {
    "astro": "^5.8.1",
    "babylonjs": "4.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "firebase-tools": "^14.5.1",
    "husky": "^9.1.7",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "yarn@1.22.22"
}
